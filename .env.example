# zhilian-client runtime configuration
# 所有 ZHILIAN_* 变量均可通过 CLI/env 覆盖（优先级：CLI > env > 配置文件 > 默认值）

# 站点
ZHILIAN_BASE_URL=https://www.zhaopin.com
ZHILIAN_LOGIN_URL=https://passport.zhaopin.com/login
ZHILIAN_API_BASE=https://fe-api.zhaopin.com

# 登录（短信模式需要；建议用 600 权限配置文件）
ZHILIAN_PHONE=

# 浏览器与 profile
ZHILIAN_PROFILE_DIR=~/.zhilian-client/profile
ZHILIAN_HEADLESS=true
ZHILIAN_LOGIN_MODE=app-qr
ZHILIAN_QR_POLL_MS=2000
ZHILIAN_HUMANIZE=true
# 遇 EdgeOne 是否自动点击「确认您是真人」复选框（默认 false，走中继）
ZHILIAN_EDGE_AUTO=false
# 未登录时是否允许匿名降级查询（1 页 20 条）
ZHILIAN_ANONYMOUS=true

# 本地 REST / MCP
ZHILIAN_API_TOKEN=change-me
ZHILIAN_HOST=127.0.0.1
ZHILIAN_PORT=8791
# 可选：常驻服务已运行时，让 CLI/MCP 通过 REST 调用（避免 profile 锁冲突）
# ZHILIAN_CLIENT_URL=http://127.0.0.1:8791

# 缓存（SQLite）
ZHILIAN_CACHE_DB=~/.zhilian-client/cache.db
ZHILIAN_CACHE_DRIVER=sqlite
ZHILIAN_SESSION_FILE=~/.zhilian-client/session.json
ZHILIAN_LOCK_FILE=~/.zhilian-client/run/zhilian.lock
ZHILIAN_CACHE_QUERY_TTL=86400
ZHILIAN_CACHE_LIST_TTL=7200
ZHILIAN_CACHE_JOB_DETAIL_TTL=43200
ZHILIAN_CACHE_COMPANY_TTL=604800
ZHILIAN_CACHE_COMPANY_JOBS_TTL=7200

# 会话 / 限频
ZHILIAN_HEARTBEAT_SEC=300
ZHILIAN_RATE_PER_MIN=15
ZHILIAN_MAX_PAGES=5
ZHILIAN_PAGE_DELAY_MS=2500
ZHILIAN_COOLDOWN_SEC=60
ZHILIAN_REQUEST_TIMEOUT_MS=30000
ZHILIAN_CONCURRENCY=1
ZHILIAN_PAGE_DELAY_JITTER_MS=1500
ZHILIAN_EDGE_WAIT_SEC=120
ZHILIAN_LOGIN_TIMEOUT_SEC=600
ZHILIAN_VERIFICATION_TTL_SEC=600
ZHILIAN_CITIES=565
ZHILIAN_ORDER=4
ZHILIAN_CHECK_TOKEN_ON_STATUS=true

# 日志
ZHILIAN_LOG_LEVEL=info
ZHILIAN_LOG_FILE=~/.zhilian-client/logs/zhilian.log
ZHILIAN_LOG_MAX_BYTES=10485760
ZHILIAN_LOG_KEEP=5
ZHILIAN_LOG_STDOUT=true
