    "salaryMax": {
      "type": "number",
      "minimum": 0
    },
    "salaryType": {
      "type": "number"
    },
    "education": {
      "default": "",
      "type": "string"
    },
    "experience": {
      "default": "",
      "type": "string"
    },
    "workType": {
      "type": "string"
    },
    "cityCode": {
      "$ref": "#/$defs/CityCode"
    },
    "cityName": {
      "type": "string"
    },
    "district": {
      "type": "string"
    },
    "address": {
      "type": "string"
    },
    "latitude": {
      "type": "number"
    },
    "longitude": {
      "type": "number"
    },
    "description": {
      "default": "",
      "type": "string"
    },
    "labels": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "welfareTags": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "publishTime": {
      "$ref": "#/$defs/IsoDateTime"
    },
    "recruiter": {
      "default": {},
      "$ref": "#/$defs/Recruiter"
    },
    "company": {
