{
  "schemaVersion": "1.0",
  "tools": [
    {
      "name": "zhilian_health",
      "description": "健康检查",
      "operationId": "health.get",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      }
    },
    {
      "name": "zhilian_status",
      "description": "登录态/模式/会话/EdgeOne/风控/缓存状态",
      "operationId": "status.get",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      }
    },
    {
      "name": "zhilian_login_start",
      "description": "开始登录：mode=app-qr|wechat-qr|sms|password",
      "operationId": "session.login.start",
      "inputSchema": {
        "type": "object",
        "properties": {
          "mode": {
            "$ref": "#/$defs/LoginMode"
          },
          "phone": {
            "type": "string",
            "pattern": "^1[3-9]\\d{9}$"
          },
          "relay": {
            "description": "仅获取登录会话信息（二维码等），不等待完成",
            "type": "boolean"
          }
        },
        "$defs": {
          "LoginStartRequest": {
            "type": "object",
            "properties": {
              "mode": {
                "$ref": "#/$defs/LoginMode"
              },
              "phone": {
                "type": "string",
                "pattern": "^1[3-9]\\d{9}$"
              },
              "relay": {
                "description": "仅获取登录会话信息（二维码等），不等待完成",
                "type": "boolean"
              }
            }
          },
          "LoginMode": {
            "type": "string",
            "enum": [
              "app-qr",
              "wechat-qr",
              "sms",
              "password"
            ]
          }
        }
      }
    },
    {
      "name": "zhilian_login_status",
      "description": "查询登录流程状态",
      "operationId": "session.login.get",
      "inputSchema": {
        "type": "object",
        "properties": {
          "loginId": {
            "$ref": "#/$defs/LoginId"
          }
        },
        "required": [
          "loginId"
        ],
        "$defs": {
          "LoginId": {
            "type": "string",
            "pattern": "^login_[A-Za-z0-9_-]{8,64}$",
            "description": "登录流程 ID"
          }
        }
      }
    },
    {
      "name": "zhilian_login_sms_verify",
      "description": "提交短信验证码",
      "operationId": "session.login.sms",
      "inputSchema": {
        "type": "object",
        "properties": {
          "loginId": {
            "$ref": "#/$defs/LoginId"
          },
          "code": {
            "type": "string",
            "pattern": "^\\d{4,8}$"
          }
        },
        "required": [
          "loginId",
          "code"
        ],
        "$defs": {
          "LoginId": {
            "type": "string",
            "pattern": "^login_[A-Za-z0-9_-]{8,64}$",
            "description": "登录流程 ID"
          }
        }
      }
    },
    {
      "name": "zhilian_login_cancel",
      "description": "取消登录流程",
      "operationId": "session.login.cancel",
      "inputSchema": {
        "type": "object",
        "properties": {
          "loginId": {
            "$ref": "#/$defs/LoginId"
          }
        },
        "required": [
          "loginId"
        ],
        "$defs": {
          "LoginId": {
            "type": "string",
            "pattern": "^login_[A-Za-z0-9_-]{8,64}$",
            "description": "登录流程 ID"
          }
        }
      }
    },
    {
      "name": "zhilian_verification_get",
      "description": "查询待处理人机验证",
      "operationId": "verification.get",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      }
    },
    {
      "name": "zhilian_verification_solve",
      "description": "提交 EdgeOne/极验答案（auto/points/offsetRatio）",
      "operationId": "verification.solve",
      "inputSchema": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "edgeone"
              },
              "auto": {
                "type": "boolean"
              },
              "points": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "x": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "y": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    }
                  },
                  "required": [
                    "x",
                    "y"
                  ]
                }
              }
            },
            "required": [
              "kind"
            ]
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "geetest"
              },
              "points": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "x": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "y": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    }
                  },
                  "required": [
                    "x",
                    "y"
                  ]
                }
              },
              "offsetRatio": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "offsetPx": {
                "type": "number",
                "minimum": 0
              }
            },
            "required": [
              "kind"
            ]
          },
          {
            "$ref": "#/$defs/NcSolve"
          }
        ],
        "$defs": {
          "VerificationSolveRequest": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "edgeone"
                  },
                  "auto": {
                    "type": "boolean"
                  },
                  "points": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "x": {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 1
                        },
                        "y": {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 1
                        }
                      },
                      "required": [
                        "x",
                        "y"
                      ]
                    }
                  }
                },
                "required": [
                  "kind"
                ]
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "geetest"
                  },
                  "points": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "x": {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 1
                        },
                        "y": {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 1
                        }
                      },
                      "required": [
                        "x",
                        "y"
                      ]
                    }
                  },
                  "offsetRatio": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "offsetPx": {
                    "type": "number",
                    "minimum": 0
                  }
                },
                "required": [
                  "kind"
                ]
              },
              {
                "$ref": "#/$defs/NcSolve"
              }
            ]
          },
          "NcSolve": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "nc"
              },
              "points": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "x": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "y": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    }
                  },
                  "required": [
                    "x",
                    "y"
                  ]
                }
              }
            },
            "required": [
              "kind"
            ]
          }
        }
      }
    },
    {
      "name": "zhilian_search_jobs",
      "description": "按关键词 + 城市搜索职位",
      "operationId": "search.jobs",
      "inputSchema": {
        "type": "object",
        "properties": {
          "keyword": {
            "type": "string",
            "minLength": 1
          },
          "cityCode": {
            "$ref": "#/$defs/CityCode"
          },
          "page": {
            "default": 1,
            "description": "页码，从 1 开始",
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "pages": {
            "default": 1,
            "description": "本次抓取页数，1-5",
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "order": {
            "default": 4,
            "type": "integer",
            "minimum": 0,
            "maximum": 99
          },
          "sortType": {
            "$ref": "#/$defs/SortType"
          },
          "refresh": {
            "default": false,
            "type": "boolean"
          }
        },
        "required": [
          "keyword"
        ],
        "$defs": {
          "SearchJobsRequest": {
            "type": "object",
            "properties": {
              "keyword": {
                "type": "string",
                "minLength": 1
              },
              "cityCode": {
                "$ref": "#/$defs/CityCode"
              },
              "page": {
                "default": 1,
                "description": "页码，从 1 开始",
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "pages": {
                "default": 1,
                "description": "本次抓取页数，1-5",
                "type": "integer",
                "minimum": 1,
                "maximum": 5
              },
              "order": {
                "default": 4,
                "type": "integer",
                "minimum": 0,
                "maximum": 99
              },
              "sortType": {
                "$ref": "#/$defs/SortType"
              },
              "refresh": {
                "default": false,
                "type": "boolean"
              }
            },
            "required": [
              "keyword"
            ]
          },
          "CityCode": {
            "type": "string",
            "pattern": "^\\d{1,6}$",
            "description": "智联城市码（jl），如 565=石家庄、489=全国"
          },
          "SortType": {
            "type": "string",
            "enum": [
              "DEFAULT",
              "HR_ACTIVE_TIME",
              "JOB_PUBLISH_TIME"
            ],
            "description": "搜索排序：DEFAULT 智能排序 / HR_ACTIVE_TIME / JOB_PUBLISH_TIME"
          }
        }
      }
    },
    {
      "name": "zhilian_list_jobs",
      "description": "按 queryId 翻页",
      "operationId": "jobs.list",
      "inputSchema": {
        "type": "object",
        "properties": {
          "queryId": {
            "type": "string"
          },
          "page": {
            "default": 1,
            "description": "页码，从 1 开始",
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "pageSize": {
            "default": 20,
            "description": "每页条数（v1 上游固定 20）",
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "refresh": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "string",
                "enum": [
                  "true",
                  "false"
                ]
              }
            ]
          }
        },
        "required": [
          "queryId"
        ],
        "$defs": {
          "JobsListQuery": {
            "type": "object",
            "properties": {
              "queryId": {
                "type": "string"
              },
              "page": {
                "default": 1,
                "description": "页码，从 1 开始",
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "pageSize": {
                "default": 20,
                "description": "每页条数（v1 上游固定 20）",
                "type": "integer",
                "minimum": 1,
                "maximum": 100
              },
              "refresh": {
                "anyOf": [
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "string",
                    "enum": [
                      "true",
                      "false"
                    ]
                  }
                ]
              }
            },
            "required": [
              "queryId"
            ]
          }
        }
      }
    },
    {
      "name": "zhilian_job_detail",
      "description": "职位详情",
      "operationId": "jobs.detail",
      "inputSchema": {
        "type": "object",
        "properties": {
          "positionNumber": {
            "$ref": "#/$defs/PositionNumber"
          },
          "refresh": {
            "default": false,
            "type": "boolean"
          }
        },
        "required": [
          "positionNumber"
        ],
        "$defs": {
          "PositionNumber": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_~.-]{6,80}$",
            "description": "智联职位号（CCL…J…），用于 /jobdetail/<number>.htm 与 position-detailv3"
          }
        }
      }
    },
    {
      "name": "zhilian_list_companies",
      "description": "职位结果按公司去重",
      "operationId": "companies.list",
      "inputSchema": {
        "type": "object",
        "properties": {
          "queryId": {
            "type": "string"
          },
          "page": {
            "default": 1,
            "description": "页码，从 1 开始",
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "pageSize": {
            "default": 20,
            "description": "每页条数（v1 上游固定 20）",
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "fetchPages": {
            "default": 0,
            "type": "integer",
            "minimum": 0,
            "maximum": 5
          },
          "refresh": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "string",
                "enum": [
                  "true",
                  "false"
                ]
              }
            ]
          }
        },
        "required": [
          "queryId"
        ],
        "$defs": {
          "CompaniesListQuery": {
            "type": "object",
            "properties": {
              "queryId": {
                "type": "string"
              },
              "page": {
                "default": 1,
                "description": "页码，从 1 开始",
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "pageSize": {
                "default": 20,
                "description": "每页条数（v1 上游固定 20）",
                "type": "integer",
                "minimum": 1,
                "maximum": 100
              },
              "fetchPages": {
                "default": 0,
                "type": "integer",
                "minimum": 0,
                "maximum": 5
              },
              "refresh": {
                "anyOf": [
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "string",
                    "enum": [
                      "true",
                      "false"
                    ]
                  }
                ]
              }
            },
            "required": [
              "queryId"
            ]
          }
        }
      }
    },
    {
      "name": "zhilian_company_detail",
      "description": "公司详情（含工商信息）",
      "operationId": "companies.detail",
      "inputSchema": {
        "type": "object",
        "properties": {
          "companyNumber": {
            "$ref": "#/$defs/CompanyNumber"
          },
          "refresh": {
            "default": false,
            "type": "boolean"
          }
        },
        "required": [
          "companyNumber"
        ],
        "$defs": {
          "CompanyNumber": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_~.-]{4,160}$",
            "description": "智联公司号（CZL…/CZ…/CC…），用于 /companydetail/<number>.htm"
          }
        }
      }
    },
    {
      "name": "zhilian_company_jobs",
      "description": "公司全部在招职位",
      "operationId": "companies.jobs",
      "inputSchema": {
        "type": "object",
        "properties": {
          "companyNumber": {
            "$ref": "#/$defs/CompanyNumber"
          },
          "page": {
            "default": 1,
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "refresh": {
            "default": false,
            "type": "boolean"
          }
        },
        "required": [
          "companyNumber"
        ],
        "$defs": {
          "CompanyNumber": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_~.-]{4,160}$",
            "description": "智联公司号（CZL…/CZ…/CC…），用于 /companydetail/<number>.htm"
          }
        }
      }
    },
    {
      "name": "zhilian_cities",
      "description": "城市注册表",
      "operationId": "cities.list",
      "inputSchema": {
        "type": "object",
        "properties": {
          "refresh": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "string",
                "enum": [
                  "true",
                  "false"
                ]
              }
            ]
          },
          "level": {
            "type": "string",
            "enum": [
              "country",
              "province",
              "city",
              "district"
            ]
          }
        },
        "$defs": {
          "CitiesQuery": {
            "type": "object",
            "properties": {
              "refresh": {
                "anyOf": [
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "string",
                    "enum": [
                      "true",
                      "false"
                    ]
                  }
                ]
              },
              "level": {
                "type": "string",
                "enum": [
                  "country",
                  "province",
                  "city",
                  "district"
                ]
              }
            }
          }
        }
      }
    },
    {
      "name": "zhilian_cache_stats",
      "description": "缓存统计",
      "operationId": "cache.stats",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      }
    },
    {
      "name": "zhilian_cache_clear",
      "description": "清缓存：scope=all|expired",
      "operationId": "cache.clear",
      "inputSchema": {
        "type": "object",
        "properties": {
          "scope": {
            "default": "all",
            "type": "string",
            "enum": [
              "all",
              "expired"
            ]
          },
          "prefix": {
            "type": "string"
          },
          "refresh": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "string",
                "enum": [
                  "true",
                  "false"
                ]
              }
            ]
          }
        },
        "$defs": {
          "CacheClearQuery": {
            "type": "object",
            "properties": {
              "scope": {
                "default": "all",
                "type": "string",
                "enum": [
                  "all",
                  "expired"
                ]
              },
              "prefix": {
                "type": "string"
              },
              "refresh": {
                "anyOf": [
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "string",
                    "enum": [
                      "true",
                      "false"
                    ]
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
