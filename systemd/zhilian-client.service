[Unit]
Description=zhilian-client (智联招聘 local read-only client)
Documentation=https://github.com/CindyRIng/zhilian-client
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/zhilian-client
EnvironmentFile=-%h/zhilian-client/.env
Environment=ZHILIAN_LOG_STDOUT=true
ExecStart=%h/zhilian-client/bin/zhilian-run serve --port 8791
Restart=always
RestartSec=5
LimitNOFILE=65536

# 无桌面服务器：用 Xvfb 提供虚拟 DISPLAY（短信登录/极验需要 headful）
# Environment=DISPLAY=:99
# ExecStartPre=/usr/bin/Xvfb :99 -screen 0 1440x900x24

[Install]
WantedBy=default.target
